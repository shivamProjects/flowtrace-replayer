# ============================================================================
#  replayer — environment configuration template
# ============================================================================
#
#  Copy to `.env` and fill in. `.env` is gitignored; this file is NOT.
#  Never paste a real credential, host, key or password into this file.
#
#  Every key below is read by code in this repo, and every key read by that code
#  is listed here. Defaults shown are the real fallbacks; if the default suits
#  you, omit the line.
#
#  This file is a REFERENCE. The reasoning — how the timeout classes relate, how
#  the AI features degrade, how the product name is resolved — is in README.md
#  under "Configuration". Only four keys are actually required: the database
#  credentials, JWT_SECRET, and ENCRYPTION_KEY if any value is stored as `ENC:`.
#
#  Marker legend:
#    [REQUIRED]  the service will not boot / will not work without it
#    [optional]  has a working default, tune only if you need to
#
#  Secret handling: keys listed in src/config/encrypted-vars.json may hold
#  EITHER a plaintext value OR an AES-256-GCM ciphertext with an `ENC:` prefix.
#  EnvEncryption transparently decrypts the latter using ENCRYPTION_KEY.
#  See src/utils/envEncryption.js.
#
# ============================================================================


# ============================================================================
#  1. SERVER
# ============================================================================

# HTTP port for the Express app (src/server.js).
# [optional] default: 9200
PORT=9200

# `production` selects the PROD_DB_* credential set in src/config/database.js.
# Anything else (including unset) selects DEV_DB_*.
# [optional] default: unset -> treated as development
NODE_ENV=development


# ============================================================================
#  2. DATABASE
# ============================================================================
#  Two credential sets; NODE_ENV picks which one is used. The queue table
#  (api_execution_history) and the script table (cus_script) both live here.

# --- Development (used unless NODE_ENV=production) ---
DEV_DB_HOST=
DEV_DB_PORT=3306
DEV_DB_NAME=
DEV_DB_USER=
DEV_DB_PASSWORD=

# --- Production (used only when NODE_ENV=production) ---
PROD_DB_HOST=
PROD_DB_PORT=3306
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=


# ============================================================================
#  3. QUEUE WORKER
# ============================================================================

# Set to `false` to run the HTTP API without picking up any queued jobs.
# [optional] default: enabled (only the literal string "false" disables it)
QUEUE_WORKER_ENABLED=true

# How many executions may run concurrently. Each one is a full browser, so
# this is bounded by RAM and CPU far sooner than by anything else.
# [optional] default: 2
QUEUE_MAX_LOAD=2

# How often to poll for queued work, ms.
# [optional] default: 5000
QUEUE_CHECK_INTERVAL=5000

# Hard ceiling on one execution, ms; the child's process tree is killed at it.
# MUST stay above REPLAY_RUN_MAX_MS or the worker kills runs that were about to
# finish and reports them failed. Raise one, raise the other.
# [optional] default: 1920000 (32 minutes)
QUEUE_EXECUTION_TIMEOUT=1920000

# When true, this worker assumes it is the only one on the queue and may
# reclaim rows left `in_execution` by a dead process. Set to `false` if you
# run more than one worker against the same database.
# [optional] default: enabled (only the literal string "false" disables it)
QUEUE_EXCLUSIVE_OWNER=true

# How often the worker sweeps stale events and reclaims rows abandoned by a dead
# process. A floor checked per poll, so it can fire no more often than
# QUEUE_CHECK_INTERVAL.
# [optional] default: 300000 (5 minutes)
QUEUE_RECONCILE_INTERVAL=300000


# ============================================================================
#  4. PLAYWRIGHT / REPLAY BEHAVIOUR
# ============================================================================

# Must be the literal string "true" to run headless; anything else is headed.
# The queue worker sets it per run, so this only affects hand-runs.
# [optional] default: headed
PLAYWRIGHT_HEADLESS=true

# Replay at the viewport size the recording was captured at, when the
# recording carries one. Off by default: a recorded viewport can be smaller
# than the elements the flow needs to reach.
# [optional] default: false
MATCH_RECORDED_VIEWPORT=false

# Keep reports on local disk instead of uploading them.
# [optional] default: false
USE_LOCAL_STORAGE=false

# Allow replaying against private / loopback hosts. Off by default so a
# recording cannot be pointed at internal infrastructure.
# [optional] default: false
REPLAY_ALLOW_PRIVATE_HOSTS=false

# Treat snapshot mismatches as failures. Off by default.
# [optional] default: false
ASSERT_SNAPSHOTS=false

# How many TRAILING steps count as "the end of the transaction" when looking for
# the identifier a commit produced. Outside that window a dialog is something
# else, and reading it reports a confidently wrong number.
# [optional] default: 5
CAPTURE_TAIL_STEPS=5

# --- Run ceiling ---------------------------------------------------------
# The total run timeout is DERIVED from the per-step budget and the recorded
# step count, not set independently — see runTimeoutMs() in
# playwright.config.ts. Set REPLAY_RUN_TIMEOUT_MS only to override it wholly.

# Absolute override for the whole run, ms. Unset = derive (recommended).
# [optional] default: unset -> derived
REPLAY_RUN_TIMEOUT_MS=

# Per-step allowance used in the derivation, ms.
# [optional] default: REPLAY_STEP_BUDGET_MS / 3 (i.e. 30000)
REPLAY_RUN_PER_STEP_MS=

# Floor and ceiling on the derived run timeout, ms. The floor also applies
# when the step count is unknown (a manual run with no actions file).
# [optional] defaults: 300000 (5 min) floor, 1500000 (25 min) ceiling
REPLAY_RUN_MIN_MS=300000
REPLAY_RUN_MAX_MS=1500000

# --- Per-step budgets ----------------------------------------------------

# What ONE step is allowed before it is abandoned, ms.
# [optional] default: 90000
REPLAY_STEP_BUDGET_MS=90000

# A step slower than this is logged as slow (does not fail it), ms.
# [optional] default: 15000
REPLAY_SLOW_STEP_MS=15000

# --- Patience: how long to wait for something EXPECTED to appear ---------

# Longest wait for the page to go quiet after an action, ms.
# [optional] default: 30000
REPLAY_SETTLE_MAX_MS=30000

# Longest wait for a navigation to complete, ms.
# [optional] default: 60000
REPLAY_NAVIGATE_MS=60000

# Longest wait for a commit's success/error message to render, ms.
# [optional] default: 8000
REPLAY_COMMIT_SCAN_MS=8000

# --- Absence: how long to wait before concluding something is NOT there --
#  These are the costly ones. Every failed lookup pays them in full, so they
#  trade run speed against tolerance for a slow app.

# Wait for an element to become visible, ms.
# [optional] default: 20000
REPLAY_VISIBLE_MS=20000

# Shorter visibility wait, used where a miss is expected and cheap, ms.
# [optional] default: 6000
REPLAY_VISIBLE_SHORT_MS=6000

# Wait for an action (click/fill) to be accepted, ms.
# [optional] default: 15000
REPLAY_ACTION_MS=15000

# Wait when reading a value back off the page, ms.
# [optional] default: 8000
REPLAY_READ_MS=8000

# Wait for a best-effort step that must not stall the run, ms.
# [optional] default: 3000
REPLAY_BEST_EFFORT_MS=3000

# Wait when probing a <select> for its options, ms.
# [optional] default: 5000
REPLAY_SELECT_PROBE_MS=5000

# Wait for a list/LOV to open, and the shorter retry wait, ms.
# [optional] defaults: 8000 and 3000
REPLAY_LIST_OPEN_MS=8000
REPLAY_LIST_OPEN_RETRY_MS=3000

# Grace period for a commit-error surface to paint before concluding the
# commit was accepted, ms. Deliberately short: an accepted save is the
# common case and must not be charged for the rejected one.
# [optional] default: 800
REPLAY_COMMIT_APPEAR_MS=800

# --- Quiet windows -------------------------------------------------------

# How long the page must be still to count as quiet, ms.
# [optional] default: 150
REPLAY_QUIET_MS=150

# Longer quiet window used to outwait an autosuggest debounce before
# anything commits the field, ms.
# [optional] default: 600
REPLAY_QUIET_AUTOSUGGEST_MS=600


# ============================================================================
#  5. APP PATCH (which ERP is being replayed)
# ============================================================================
#  The patch registry (engine/patches/index.ts) picks a patch by matching the
#  recording's URL, falling back to `generic`. Adding an ERP means writing a
#  patch and registering it — no file under engine/ changes.

# Force a specific patch instead of auto-detecting from the URL. Useful when
# the recording's URL lies (reverse proxy, vanity domain) or to test a patch
# in isolation. Valid values today: oracle-fusion, generic
# [optional] default: unset -> auto-detect
APP_PATCH=

# What the AI features call this application, in prompts. A matched patch and the
# queue worker both override it — see "Product identity" in README.md.
# [optional] default: Oracle Fusion Cloud
PRODUCT_NAME=

# --- Credential override -------------------------------------------------
#  Replaces the value of any recorded step filling a username/password field, so
#  one recording can run against several instances without re-recording.

# [optional] default: false
USE_ENV_CREDENTIALS=false

# Required only when USE_ENV_CREDENTIALS=true. Leave blank in this file.
REPLAY_USERNAME=
REPLAY_PASSWORD=

# Deprecated older names for the two above, still honoured so an existing .env
# keeps working. Prefer REPLAY_USERNAME/REPLAY_PASSWORD.
ORACLE_USERNAME=
ORACLE_PASSWORD=


# ============================================================================
#  6. AI STEP RECOVERY
# ============================================================================
#  When a recorded selector fails, a model is given browser tools and asked to
#  complete the step's stated goal. A credential-bearing step is NEVER sent to a
#  model, and per-run attempt/time caps bound the cost.
#  See "AI features" in README.md for how the transports and caching work.

# Master switch. Must be the literal string "true" to enable.
# [optional] default: false
AI_RECOVERY_ENABLED=false

# How to reach a model: `cli` bills a subscription, `api` bills a key. The cli
# path falls back to api if the CLI is not logged in. They cannot cross — the CLI
# child has ANTHROPIC_API_KEY removed from its environment.
# [optional] default: cli
AI_RECOVERY_METHOD=cli

# Where the `claude` executable is, when AI_RECOVERY_METHOD=cli. Set this when
# the binary is not on the service's PATH — a systemd or pm2 unit does not
# inherit the login shell's PATH, so a CLI that works in your terminal is often
# simply not found there, and every attempt silently falls back to the api path.
# AI_RECOVERY_CLI_PATH wins; CLAUDE_CLI_PATH is the fallback name for the same
# thing. Either may be a bare command name or an absolute path.
# [optional] default: claude (resolved via PATH)
AI_RECOVERY_CLI_PATH=
CLAUDE_CLI_PATH=

# Model the CLI is asked for. CLI path only — the api path uses
# AI_RECOVERY_MODEL. An ALIAS is the default on purpose: the CLI resolves
# `sonnet` / `opus` to whatever the subscription currently entitles, which is
# what a plan-billed run should follow. A pinned model id works too, but will
# fail outright once the plan stops entitling it.
# [optional] default: sonnet
CLAUDE_CLI_MODEL=

# WHICH API, when the api path runs: `anthropic` (default) | `gemini` | `openai`.
# `openai` also accepts any OpenAI-compatible endpoint via AI_RECOVERY_BASE_URL.
# [optional] default: anthropic
AI_RECOVERY_API_PROVIDER=anthropic

# DEPRECATED former name for the line above. Still honoured as a fallback, with
# a warning, because it was documented here while only the new name was read.
# Prefer AI_RECOVERY_API_PROVIDER; leave this unset.
# Read directly by engine/ai-recovery.ts (defaulting to `anthropic`) and by
# apiProviderId() in engine/ai-recovery-dispatch.ts, which warns when it is set.
# [optional] DEPRECATED — default: unset -> AI_RECOVERY_API_PROVIDER is used
AI_RECOVERY_PROVIDER=

# How full the reused CLI session may get before it is compacted, as a fraction
# of the context window. CLI path only.
# [optional] default: 0.6
AI_RECOVERY_COMPACT_THRESHOLD=0.6

# Model id. The default depends on the provider:
#   anthropic -> claude-opus-5
#   openai    -> gpt-4o
# [optional] default: per provider, as above
AI_RECOVERY_MODEL=

# Max tool-use iterations in one recovery attempt.
# [optional] default: 12
AI_RECOVERY_MAX_ITERATIONS=12

# --- Keys — set only the one matching AI_RECOVERY_API_PROVIDER -----------

# Used when AI_RECOVERY_API_PROVIDER=anthropic. Leave blank here.
ANTHROPIC_API_KEY=

# Used when AI_RECOVERY_API_PROVIDER=openai. AI_RECOVERY_API_KEY takes
# precedence; OPENAI_API_KEY is the fallback. Leave blank here.
AI_RECOVERY_API_KEY=
OPENAI_API_KEY=

# Used when AI_RECOVERY_API_PROVIDER=gemini. Leave blank here.
GEMINI_API_KEY=

# Override the OpenAI-compatible base URL (for a proxy, a gateway, or a
# non-OpenAI vendor that speaks the same wire format).
# [optional] default: unset -> the provider's own endpoint
AI_RECOVERY_BASE_URL=

# --- Per-run caps --------------------------------------------------------
#  Properties of the RUN, not of one step: the recovery module only ever sees
#  a single step, so these are enforced by the engine around it.

# Time one recovery attempt may take, ms.
# [optional] default: 90000
REPLAY_RECOVERY_MS=90000

# Total recovery time allowed across the whole run, ms.
# [optional] default: 240000 (4 minutes)
REPLAY_RECOVERY_RUN_MS=240000

# Max recovery attempts in one run, regardless of remaining time.
# [optional] default: 3
REPLAY_RECOVERY_MAX_ATTEMPTS=3

# Ceiling the recovery dispatcher puts on ONE model call, ms. Distinct from
# REPLAY_RECOVERY_MS above: that is the engine's per-attempt budget, this is the
# transport's own timeout, and the run's REMAINING budget always wins over both
# (the dispatcher takes the smaller of the two). The default is deliberately far
# above REPLAY_RECOVERY_MS, so in a normal run the engine's budget is what bites
# and this only catches a call that has genuinely hung.
# [optional] default: 300000 (5 minutes)
AI_RECOVERY_TIMEOUT_MS=300000

# --- Commit-error classification -----------------------------------------
#  When the application REFUSES to save, it returns sentences, not codes. This
#  names the kind of problem ("Duplicate Data", "Missing Data") so failures can
#  be grouped in the report instead of all landing under one heading.
#
#  Each distinct message costs one model call in its lifetime: answers are
#  cached, keyed on the message with its variable parts masked, so a repeat
#  costs nothing. Under the worker the cache is the database; standalone runs
#  keep it in .commit-error-types.json.

# Follows AI_RECOVERY_ENABLED unless set explicitly. Always uses an API key —
# this path has no CLI transport.
# [optional] default: unset -> follows AI_RECOVERY_ENABLED
COMMIT_TYPE_ENABLED=

# Naming a category from a sentence is cheap work on an already-failed step, so a
# larger model buys only latency.
# [optional] default: claude-haiku-4-5
COMMIT_TYPE_MODEL=

# Where the label cache lives. The worker sets this per execution; setting it by
# hand also makes the caller responsible for persisting it.
# [optional] default: unset -> <project>/.commit-error-types.json
COMMIT_TYPE_CACHE_PATH=

# How many labels the worker hands the run. The cache is a snapshot of the table
# taken before the run starts, so this bounds the file, not the table.
# [optional] default: 500
COMMIT_TYPE_CACHE_LIMIT=


# ============================================================================
#  7. SCREENSHOTS & REPORTING
# ============================================================================
#  Two separate pipelines over the SAME source PNGs, tuned for two different
#  audiences and never sharing settings:
#
#    · LIVE_*  — frames streamed to whoever is watching the run in a browser
#                pane (src/queue/specRunner.js). Small and fast matters; the
#                frame is discarded a second later.
#    · REPORT_* — the customer-facing PDF (src/reporting/reportGenerator.js).
#                Re-encoded from the original files at print resolution, so
#                nothing here affects the live view and vice versa.
#
#  The spec captures at the browser's real resolution (3024px on a retina
#  runner, 100-450KB per PNG). Both pipelines downscale from that; neither
#  enlarges.

# --- Live view -----------------------------------------------------------

# Width live frames are downscaled to, px. Measured: 1200px costs ~5x less than
# the raw capture and still reads clearly for a person watching.
# [optional] default: 1200
LIVE_SCREENSHOT_WIDTH=1200

# Encoding for live frames: `jpeg` (default) | `webp` | `png`.
# Measured on real captures at 1200px — jpeg 15ms/26KB, png 49ms/61KB, webp
# 11ms-class at 32ms — because palette PNG spends its time quantising colours
# for a losslessness the live view does not need. Overridable because the frame
# is rendered by a frontend this service does not own: if a UI hard-codes
# `data:image/png`, set this to `png` to put it back without a redeploy. Use
# `webp` only for browsers known to support it.
# [optional] default: jpeg
LIVE_SCREENSHOT_FORMAT=jpeg

# Encoder quality for live frames, 1-100. Applies to jpeg and webp; ignored for
# png, which is lossless. Below ~60 the ERP's thin table rules and small labels
# start to smear, which is exactly what a watcher is trying to read.
# [optional] default: 72
LIVE_SCREENSHOT_QUALITY=72

# --- PDF report ----------------------------------------------------------
#  These two were tuned by measurement, and both are already at the point where
#  lowering them was observed to make screenshots look SOFT — a report is read
#  zoomed in, on a step that has usually just failed, so legibility of a field
#  label or an error sentence is the whole value of the image. Raising them
#  mainly grows the PDF.
#
#  Note the report does not simply trust JPEG: it encodes BOTH a JPEG at the
#  quality below and a palette PNG, and keeps the lossless PNG whenever it is no
#  more than 1.2x the JPEG's size (see encodeScreenshot). So on the flat, mostly
#  solid-colour screens an ERP produces, the PDF often ends up lossless anyway
#  and REPORT_JPEG_QUALITY never comes into it.

# Width report screenshots are downscaled to, px. Print resolution — deliberately
# much larger than the live width.
# [optional] default: 1600
REPORT_SCREENSHOT_WIDTH=1600

# JPEG quality for the report, 1-100. Encoded with mozjpeg and 4:4:4 chroma
# subsampling (no colour-channel downsampling), because subsampling is what
# blurs coloured text and status chips against a light background.
# [optional] default: 82
REPORT_JPEG_QUALITY=82


# ============================================================================
#  8. AUTH & ENCRYPTION
# ============================================================================

# Verifies bearer tokens on the HTTP API (src/middleware/auth.middleware.js).
# Must match whatever issues the tokens.
# [REQUIRED]
JWT_SECRET=replace-me-with-a-long-random-string

# Passphrase for the AES-256-GCM `ENC:` values in
# src/config/encrypted-vars.json. Without it those cannot be decrypted.
# [REQUIRED if any encrypted var is used]
ENCRYPTION_KEY=replace-me-with-a-long-random-passphrase


# ============================================================================
#  Set automatically by the runner — DO NOT configure these
# ============================================================================
#  The queue worker injects these into the Playwright child per execution.
#  Setting them by hand only makes sense for running the engine standalone
#  against a recording file.
#
#    JOB_ACTIONS_PATH     actions JSON for this execution
#    JOB_SCREENSHOT_DIR   where step_<N>.png are written
#    JOB_RESULTS_PATH     where per-step results are written
#    JOB_EXECUTION_ID     execution row id, echoed into @@EVENT lines
#    CI                   set by CI; affects Playwright reporter defaults
